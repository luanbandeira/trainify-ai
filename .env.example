# ── LLM externa (usada apenas na geração da resposta / do quiz) ──
# Chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
# Modelo maior só para gerar quiz (mais preciso nas alternativas)
QUIZ_LLM_MODEL=openai/gpt-oss-120b
# Para trocar de provedor: instale o pacote (ex.: pip install langchain-anthropic),
# defina LLM_PROVIDER=anthropic, LLM_MODEL=<modelo> e ANTHROPIC_API_KEY=...

# ── Integração com o Trainify ──
# Chave compartilhada com o backend Spring (cabeçalho X-Internal-Key).
# Vazia = sem checagem, só para desenvolvimento local.
INTERNAL_API_KEY=
# Hosts de onde o serviço aceita baixar PDFs das aulas
PDF_ALLOWED_HOSTS=amazonaws.com,docs.google.com

# ── Demonstração (interface web em http://localhost:8000) ──
DEMO_MODE=true

# ── Ajustes finos do RAG (opcionais) ──
# TOP_K=6
# MIN_SCORE=0.845
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# HISTORY_MESSAGES=6
